// ฟังก์ชันวาดหน้าจอแชท (รูปขวาใน Mockup)
void DrawChatLayout(ChatbotLogic* brain, char* inputBuffer, ImFont* fontReg) {

    if (fontReg) {
        ImGui::PushFont(fontReg);
        ImGui::SetWindowFontScale(0.5f); 
    }

    if (fontReg != nullptr) {
        ImGui::PushFont(fontReg);
    }
    
    float windowWidth = ImGui::GetWindowWidth();
    float windowHeight = ImGui::GetWindowHeight();
    float footerHeight = 100.0f; // ปรับความสูง Footer นิดหน่อยเผื่อความโค้งมน
    float chatHistoryHeight = windowHeight - footerHeight;

    // --- โซนที่ 1: ประวัติการแชท ---
    ImGui::BeginChild("ChatHistoryRegion", ImVec2(windowWidth, chatHistoryHeight), false, ImGuiWindowFlags_AlwaysVerticalScrollbar);
    
    ImGui::Spacing();

    for (const std::string& msg : brain->chatHistory) {
        bool isUser = (msg.find("User:") == 0);
        
        // คำนวณขนาดข้อความเพื่อนำไปจัดตำแหน่งชิดซ้าย/ขวา
        float textWidth = ImGui::CalcTextSize(msg.c_str()).x;
        float bubblePadding = 30.0f; 

        if (isUser) {
            // >>> User: จัดชิดขวา (ตามรูป Mockup) <<<
            ImGui::SetCursorPosX(windowWidth - textWidth - bubblePadding);
            ImGui::TextWrapped("%s", msg.c_str()); 
        } else {
            // >>> Chatbot: จัดชิดซ้าย <<<
            ImGui::SetCursorPosX(bubblePadding);
            ImGui::TextWrapped("%s", msg.c_str());
        }
        ImGui::Spacing(); ImGui::Separator(); ImGui::Spacing();
    }
    
    if (ImGui::GetScrollY() >= ImGui::GetScrollMaxY()) {
        ImGui::SetScrollHereY(1.0f);
    }

    ImGui::EndChild();

    // --- โซนที่ 2: ช่องพิมพ์ข้อความด้านล่าง (Footer) ---
    // ปรับตำแหน่งให้ดู "ลอย" ขึ้นมาเล็กน้อยเพื่อความ Modern
    ImGui::SetCursorPos(ImVec2(windowWidth * 0.1f, windowHeight - 60)); 
    
    float inputWidth = windowWidth * 0.8f; // ให้กว้าง 80% ของจอ
    ImGui::PushItemWidth(inputWidth);
    
    if (ImGui::InputText("##BottomInput", inputBuffer, 256, ImGuiInputTextFlags_EnterReturnsTrue)) {
        brain->processInput(inputBuffer);
        inputBuffer[0] = '\0';
    }
    ImGui::PopItemWidth();

    if (fontReg != nullptr) ImGui::PopFont();

    if (fontReg) {
        ImGui::SetWindowFontScale(1.0f);
        ImGui::PopFont();
    }

}

