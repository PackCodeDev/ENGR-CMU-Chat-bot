// ฟังก์ชันวาดหน้าจอต้อนรับ (รูปซ้ายใน Mockup)
// แก้ไข Signature ของฟังก์ชันให้รับฟอนต์ 2 ตัว
void DrawWelcomeLayout(ChatbotLogic* brain, char* inputBuffer, ImFont* fontReg, ImFont* fontBold) {

    if (fontReg) {
        ImGui::PushFont(fontReg);
        ImGui::SetWindowFontScale(0.5f); // ย่อเพื่อให้ฟอนต์ 48px คมชัดบนจอ Predator
    }

    ImVec2 centerPos = ImGui::GetMainViewport()->GetCenter();
    float windowWidth = ImGui::GetMainViewport()->Size.x;
    float windowHeight = ImGui::GetMainViewport()->Size.y;

    // --- 1. โลโก้ "Gemini" ที่มุมซ้ายบน ---
    if (fontBold) {
        ImGui::PushFont(fontBold);
        ImGui::SetWindowFontScale(0.4f); // ขนาดเล็กพอดีๆ มุมจอ
        ImGui::SetCursorPos(ImVec2(30, 30));
        ImGui::Text("ENGR-CMU Chatbot");
        ImGui::PopFont();
    }

    // --- 2. ข้อความ "Hi [UserName]" พร้อมไอคอนดาว ---
    if (fontReg) {
        ImGui::PushFont(fontReg);
        ImGui::SetWindowFontScale(0.6f);
        
        // จำลองไอคอนดาวหลากสี
        std::string greeting = "สวัสดีครับ" + brain->userName;
        float greetWidth = (ImGui::CalcTextSize(greeting.c_str()).x + 40) * 0.6f;
        
        ImGui::SetCursorPos(ImVec2(centerPos.x - (greetWidth / 2), centerPos.y - 150));
        ImGui::TextColored(ImVec4(0.4f, 0.7f, 1.0f, 1.0f), "*"); // ไอคอนดาวจำลอง
        ImGui::SameLine();
        ImGui::Text("%s", greeting.c_str());
        ImGui::PopFont();
    }

    // --- 3. หัวข้อหลัก "Where should we start?" ---
    if (fontBold) {
        ImGui::PushFont(fontBold);
        ImGui::SetWindowFontScale(0.8f);
        std::string mainTitle = "ผมขอทราบชื่อคุณหน่อยนะครับ...";
        float titleWidth = ImGui::CalcTextSize(mainTitle.c_str()).x * 0.8f;
        
        ImGui::SetCursorPos(ImVec2(centerPos.x - (titleWidth / 2), centerPos.y - 100));
        ImGui::Text("%s", mainTitle.c_str());
        ImGui::PopFont();
    }

    // --- 4. กล่องข้อความ Ask Gemini 3 (ตัดปุ่มล่างออกแล้ว) ---
    float inputWidth = windowWidth * 0.65f; // กว้าง 65% ของจอ
    ImGui::SetCursorPos(ImVec2(centerPos.x - (inputWidth / 2), centerPos.y - 20));

    // ตกแต่งกล่องให้เหมือนในรูป (สีเทาเข้ม, ขอบมนมาก)
    ImGui::PushStyleColor(ImGuiCol_FrameBg, ImVec4(0.12f, 0.12f, 0.12f, 1.0f));
    ImGui::PushStyleVar(ImGuiStyleVar_FramePadding, ImVec2(25, 20));
    ImGui::PushStyleVar(ImGuiStyleVar_FrameRounding, 25.0f);
    
    ImGui::PushItemWidth(inputWidth);
    if (fontReg) ImGui::PushFont(fontReg);
    
    // ใส่ Hint แทนคำว่า Ask Gemini 3
    if (ImGui::InputTextWithHint("##ENGR-CMU ChatbotInput", "ENGR-CMU Chatbot", inputBuffer, 256, ImGuiInputTextFlags_EnterReturnsTrue)) {
        brain->processInput(inputBuffer);
        inputBuffer[0] = '\0';
    }

    if (fontReg) ImGui::PopFont();
    ImGui::PopItemWidth();
    ImGui::PopStyleVar(2);
    ImGui::PopStyleColor();

    if (fontReg) {
        ImGui::SetWindowFontScale(1.0f); // คืนค่า Scale กลับเป็นปกติ
        ImGui::PopFont();                // คืนค่าฟอนต์ (ห้ามลืมเด็ดขาด!)
    }
}

