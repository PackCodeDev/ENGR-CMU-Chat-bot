// --- [ส่วนที่ 1: สมองของบอท (Logic Class)] --- //
//------------------------------------------------------------------------------------------------------------------------------------------------//
class ChatbotLogic {                      //: เริ่มต้นประกาศคลาสเพื่อรวมศูนย์ "Logic" หรือตรรกะการทำงานไว้ที่เดียว ไม่ให้ไปปนกับส่วนแสดงผล (UI)//
public:                                   // เปิดสาธารณะ //
    int state = -1;                       //ตัวแปรสำหรับเช็คว่าตอนนี้เราคุยกันถึงไหนแล้ว โดยเริ่มที่ -1 (โหมดถามชื่อ) ซึ่งเป็นเทคนิคที่ใช้ควบคุม Flow การทำงาน//
    std::string userName;                 //ตัวแปรสำหรับเก็บชื่อผู้ใช้งานที่บอทถามมา//
    std::vector<std::string> chatHistory; //ตัวนี้คือ "ลิ้นชักเก็บความจำ" ครับ เป็นอาร์เรย์ที่ยืดหดได้สำหรับเก็บประวัติการแชททั้งหมด//

    ChatbotLogic() {                      //นี่คือฟังก์ชันพิเศษที่จะทำงานทันทีที่คุณสร้างบอทขึ้นมา (สร้างเสร็จปุ๊บ ทำปั๊บ)//
        chatHistory.push_back("Chatbot : สวัสดีครับ! ขอทราบชื่อของคุณหน่อยครับ");
        //*chatHistory.push_back คือการสั่งให้ เพิ่มข้อมูลใหม่เข้าไปต่อท้ายสุด ของ std::vector ซึ่ง chatHistory ถูกประกาศเป็น std::vector<std::string>*//
    }

    void processInput(std::string input) { //ฟังก์ชันนี้เปรียบเหมือน "หู" ที่คอยรับข้อความที่คุณพิมพ์มาจากหน้าจอ ImGui//
        if (input.empty()) return;         //เป็นการป้องกัน (Guard Clause) ว่าถ้าคุณเผลอกด Enter โดยที่ไม่ได้พิมพ์อะไรเลย ให้บอทเฉยไว้ ไม่ต้องทำอะไรต่อ//
        chatHistory.push_back("User: " + input); //เมื่อคุณพิมพ์มา บอทจะรีบจดบันทึกทันที แล้วเก็บลงประวัติเพื่อให้ UI เอาไปวาดเป็น Chat Bubble ฝั่งขวานั่นเอง//
//------------------------------------------------------------------------------------------------------------------------------------------------//

    //[ด่านที่ 1: รับชื่อ (เหมือนเวอร์ชัน Terminal)]//
    if (state == -1) {                     //เช็คเงื่อนไขว่า "ตอนนี้บอทกำลังรอรับชื่ออยู่ใช่ไหม?"//
        userName = input;                  //ข้อความที่ User ไปเก็บไว้ในตัวแปร userName//
        state = 0;                         //เปลี่ยนสถานะของโปรแกรมจาก -1 (โหมดรับชื่อ) เป็น 0 (โหมดเมนูหลัก)//
        chatHistory.push_back("Chatbot: ยินดีที่ได้รู้จักครับ คุณ " + userName + "!");
        addMenuMessage();                  //เรียกใช้ฟังก์ชัน addMenuMessage() (ซึ่งเป็นฟังก์ชันแยก) เพื่อพิมพ์รายการเมนู 1, 2, 3 ออกมาให้ User เลือก//
        return; 
        }
//------------------------------------------------------------------------------------------------------------------------------------------------//

    //[ด่านที่ 2: เลือกเมนูหลัก (1-3)]//
    if (state == 0) {                      //ถ้าเข้าสู่เมนูหลัก จะทำงานดังนี้//
        if (input == "1") {                //เลือก 1 คือสถานะ "อยากเข้าศึกษา"//
            state = 1; 
            chatHistory.push_back("Chatbot: --- เข้าสู่โหมด Admission ---");
            chatHistory.push_back("Chatbot: อยากทราบเรื่อง 'รอบรับ', 'คะแนน', 'เครื่องกล' หรือ 'คอมพิวเตอร์' ครับ?"); 
        }else if (input == "2") {          //เลือก 2 คือสถานะ "นักศึกษาใหม่"//
            state = 2; 
            chatHistory.push_back("Chatbot: ยินดีด้วยนะลูกช้างใหม่! ข้อมูลตารางสอนจะประกาศเร็ว ๆ นี้ครับ");
            state = 0; // ทำงานเสร็จแล้วกลับมาเมนูหลัก
            addMenuMessage();
        }else if (input == "3") {          //เลือก 3 คือสถานะ "ทั่วไป"//
            state = 3; 
            chatHistory.push_back("Chatbot: มีเรื่องอะไรที่อยากทราบเป็นพิเศษไหมครับ? พิมพ์ถามได้เลย!");
            state = 0;
            addMenuMessage();
        }else{
            chatHistory.push_back("Chatbot: กรุณาเลือกตัวเลข 1, 2 หรือ 3 เท่านั้นครับ");  //นอกเหหนือจกานี้ ให้ตี error แล้วเลือกใหม่//
            }
            return;
        }
//------------------------------------------------------------------------------------------------------------------------------------------------//

    //[ด่านที่ 3: จัดการ Keyword ในโหมด Admission]//
    if (state == 1) {
        if (input == "ออก") {              //หากพิมพ์ ออก จะกลับไปหน้าคำถามเลือกสถานะ//
            state = 0;
            chatHistory.push_back("Chatbot: กลับสู่เมนูหลักครับ");
            addMenuMessage();
            return;
            }


            //*[กล่อง keyword]*//
            std::vector<std::string> keywords = {
                "รอบรับ",
                "คะแนน",
                "เครื่องกล",
                "คอมพิวเตอร์"
            }; 


            //*[[กล่องคำตอบ]*//
            const char *responses[] = {
                "คณะเราเปิดรับ 3 รอบหลักครับ...",
                "คะแนนย้อนหลังดูได้ที่เว็บไซต์ reg.cmu.ac.th",
                "วิศวะเครื่องกลเน้นการออกแบบเครื่องจักรและพลังงาน",
                "วิศวะคอมฯ เรียนทั้ง Hardware, Software และ AI"
            };


            //[หากไม่มี keyword ที่ตรง]//
            bool found = false;
            for (size_t i = 0; i < keywords.size(); i++) {
                if (input.find(keywords[i]) != std::string::npos) {
                    chatHistory.push_back("Chatbot: " + std::string(*(responses + i)));
                    found = true;
                    break;
                }
            }
            if (!found) chatHistory.push_back("Chatbot: ไม่พบข้อมูล ลองถามเรื่อง 'รอบรับ' หรือพิมพ์ 'ออก'");
        }
    }
//------------------------------------------------------------------------------------------------------------------------------------------------//

//[ฟังก์ชัน addMenuMessage ที่นำมาใช้ถามเรื่องสถานะ]//
private:
    void addMenuMessage() {
        chatHistory.push_back("-----------------------------");
        chatHistory.push_back("Chatbot: กรุณาเลือกสถานะของคุณ:");
        chatHistory.push_back("[1] สนใจเข้าเรียน (Admission)");
        chatHistory.push_back("[2] นักศึกษาใหม่ปี 1 (Freshman)");
        chatHistory.push_back("[3] ถามตอบทั่วไป (General Q&A)");
        chatHistory.push_back("-----------------------------");
    }
};
