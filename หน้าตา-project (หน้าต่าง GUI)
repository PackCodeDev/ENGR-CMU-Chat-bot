//[ตกแต่งหน้าตา (Theme)]//
void SetupModernAITheme() {
    ImGuiStyle& style = ImGui::GetStyle();
    style.Colors[ImGuiCol_WindowBg]         = ImVec4(0.09f, 0.09f, 0.10f, 1.00f); //สีพื้นหลังของหน้าต่าง//
    style.Colors[ImGuiCol_ChildBg]          = ImVec4(0.11f, 0.11f, 0.12f, 1.00f); //สีพื้นหลังของกล่องแชท//
    style.Colors[ImGuiCol_Button]           = ImVec4(0.15f, 0.15f, 0.16f, 1.00f); //สีพื้นหลังของปุ่ม//
    style.Colors[ImGuiCol_ButtonHovered]    = ImVec4(0.20f, 0.20f, 0.22f, 1.00f); //สีพื้นหลังของปุ่มในจังหวะที่เราเอาเมาส์ไปวางทับ//
    style.Colors[ImGuiCol_FrameBg]          = ImVec4(0.15f, 0.15f, 0.16f, 1.00f); //สีพื้นหลังของกล่องข้อความ//

    style.WindowRounding = 12.0f;           //ปรับความโค้งที่มุมของหน้าต่างหลัก (Window)//
    style.FrameRounding = 40.0f;            //ปรับความโค้งของกรอบต่าง ๆ เช่น ปุ่ม และช่อง Input Text//
    style.ScrollbarRounding = 10.0f;        //ปรับให้แถบเลื่อน (Scrollbar) มีมุมมน ๆ ดูลื่นตาเวลาเราเลื่อนดูประวัติการแชท//

    style.ItemSpacing = ImVec2(10, 15);     //การเว้นระยะห่างระหว่าง "สิ่งของ" ที่วางต่อกัน//
    style.WindowPadding = ImVec2(20, 20);   //คือการเว้นระยะห่างจาก "ขอบหน้าต่าง" เข้ามาถึงเนื้อหาข้างใน//
}

