// --- [ฟังก์ชันหลัก (GUI Setup) --> หน้า UI] --- //
int main() {
    // --- [1. ตรวจสภาพความพร้อมระบบพื้นฐาน] ---
    if (!glfwInit()) {
        std::cout << "Failed to initialize GLFW" << std::endl;
        return 1;
    }

    // --- [2. ตั้งค่าหน้าต่าง GUI ให้เต็มจอ] ---
    glfwWindowHint(GLFW_MAXIMIZED, GLFW_TRUE);
    glfwWindowHint(GLFW_SCALE_TO_MONITOR, GLFW_TRUE);
    GLFWwindow* window = glfwCreateWindow(1920, 1080, "ENGR CMU Chatbot (High-Res Version)", NULL, NULL);

    if (window == NULL) {
        std::cout << "Failed to create GLFW window" << std::endl;
        glfwTerminate();
        return 1;
    }

    glfwMakeContextCurrent(window);
    glfwSwapInterval(1); // เปิด V-Sync ให้ภาพสมูท

    // --- [3. ติดตั้งระบบ ImGui] ---
    IMGUI_CHECKVERSION();
    ImGui::CreateContext();
    ImGuiIO& io = ImGui::GetIO(); (void)io;
    SetupModernAITheme(); // เรียกใช้ธีม Modern ที่เราออกแบบไว้

    // --- [4. โหลดฟอนต์ภาษาไทย] ---
    // --- [ลบของเก่าทิ้ง แล้วใช้ชุดนี้ชุดเดียวเพื่อจบทุกปัญหา] ---
    ImFontConfig config;
    config.OversampleH = 1; 
    config.OversampleV = 1; 
    config.PixelSnapH = true;

    // --- [ใช้ 2 บรรทัดนี้เพื่อแก้ปัญหาไม้เอกหาย] ---
    // 1. ดันตัวอักษรลงมาให้พ้นขอบบนของกล่องพิกเซล
    config.GlyphOffset.y = 10.0f; 
    
    // 2. สั่งให้จองพื้นที่ความกว้างพื้นฐานเป็น 0 เพื่อไม่ให้ไปเบียดวรรณยุกต์ตัวข้างๆ
    config.GlyphMinAdvanceX = 0.0f; 

    // โหลดฟอนต์ขนาดใหญ่ (48px) เพื่อแก้ภาพแตก
    ImFont* fontRegular = io.Fonts->AddFontFromFileTTF("Sarabun/Sarabun-Regular.ttf", 48.0f, &config, io.Fonts->GetGlyphRangesThai());
    ImFont* fontBold = io.Fonts->AddFontFromFileTTF("Sarabun/Sarabun-Bold.ttf", 64.0f, &config, io.Fonts->GetGlyphRangesThai());

    // --- [บล็อกเดิมที่คุณถาม: ใช้เป็นแผนสำรองได้เหมือนเดิม] ---
    if (fontRegular == nullptr || fontBold == nullptr) {
        std::cout << "Error: Could not load Sarabun fonts! Using default..." << std::endl;
        fontRegular = io.Fonts->AddFontDefault();
        fontBold = fontRegular; 
    }

    // --- [5. เชื่อมต่อ Backend (ต้องทำก่อนเริ่ม Loop)] ---
    ImGui_ImplGlfw_InitForOpenGL(window, true);
    ImGui_ImplOpenGL3_Init("#version 130");

    unsigned char* pixels;
    int width, height;
    io.Fonts->GetTexDataAsRGBA32(&pixels, &width, &height);

    GLuint font_texture;
    glGenTextures(1, &font_texture);
    glBindTexture(GL_TEXTURE_2D, font_texture);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, width, height, 0, GL_RGBA, GL_UNSIGNED_BYTE, pixels);

    io.Fonts->TexID = (ImTextureID)(intptr_t)font_texture;

    // --- [6. เตรียมข้อมูลและสมองของบอท] ---
    ChatbotLogic *brain = new ChatbotLogic(); // จอง Memory แบบ Heap (Lecture 17)
    static char inputBuffer[256] = ""; 
    std::cout << "Success: Chatbot is running!" << std::endl;

    // -------------------------------------------------------------------------
    // --- [START Main Loop: วงจรชีวิตของโปรแกรม] ---
    // -------------------------------------------------------------------------
    while (!glfwWindowShouldClose(window)) {
        // กฎเหล็กขั้นตอนที่ 1: รับเหตุการณ์จากเมาส์และคีย์บอร์ด
        glfwPollEvents();

        int display_w, display_h;
        glfwGetFramebufferSize(window, &display_w, &display_h);
        glViewport(0, 0, display_w, display_h);

        // กฎเหล็กขั้นตอนที่ 2: เตรียมเฟรมใหม่ (สำคัญมาก! เพื่อแก้ปัญหา Assertion failed)
        ImGui_ImplOpenGL3_NewFrame();
        ImGui_ImplGlfw_NewFrame();
        ImGui::NewFrame();

        // --- [เริ่มการวาดหน้าจอหลัก (Canvas)] ---
        ImGuiViewport* viewport = ImGui::GetMainViewport();
        ImGui::SetNextWindowPos(viewport->Pos);
        ImGui::SetNextWindowSize(viewport->Size);

        // รวม Flags ของหน้าต่าง Background ไว้ที่เดียว
        ImGuiWindowFlags window_flags = ImGuiWindowFlags_NoTitleBar | 
                                        ImGuiWindowFlags_NoCollapse | 
                                        ImGuiWindowFlags_NoResize | 
                                        ImGuiWindowFlags_NoMove | 
                                        ImGuiWindowFlags_NoBringToFrontOnFocus | 
                                        ImGuiWindowFlags_NoNavFocus | 
                                        ImGuiWindowFlags_NoBackground;

        ImGui::PushStyleVar(ImGuiStyleVar_WindowRounding, 0.0f);
        ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(0.0f, 0.0f));
        
        ImGui::Begin("MainRootCanvas", NULL, window_flags);
        ImGui::PopStyleVar(2);

        // --- [จุดตัดสินใจ: เลือกวาดหน้าจอตาม Mockup ที่คุณวาดมา] ---
        bool isChatStarted = (brain->chatHistory.size() > 1);

        // ใน Main Loop...
        if (!isChatStarted) {
        // ส่งทั้ง fontRegular และ fontBold เข้าไป
        DrawWelcomeLayout(brain, inputBuffer, fontRegular, fontBold);
        } else {
        // หน้าแชทใช้แค่ตัวปกติก็พอ
        DrawChatLayout(brain, inputBuffer, fontRegular);
        }

        ImGui::End(); // ปิด MainRootCanvas

        // กฎเหล็กขั้นตอนที่ 3: สั่งวาดข้อมูลลงจอจริง
        ImGui::Render();
        ImGui_ImplOpenGL3_RenderDrawData(ImGui::GetDrawData());
        glfwSwapBuffers(window);
    }
    // --- [END Main Loop] ---

    // --- [7. คืนความจำให้ระบบ (Cleanup)] ---
    delete brain; // คืนหน่วยความจำ (Lecture 17)
    brain = NULL;

    ImGui_ImplOpenGL3_Shutdown();
    ImGui_ImplGlfw_Shutdown();
    ImGui::DestroyContext();

    glfwDestroyWindow(window);
    glfwTerminate();

    return 0;
}
